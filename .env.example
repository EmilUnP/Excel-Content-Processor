# Required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional attribution shown on your OpenRouter dashboard.
#OPENROUTER_SITE_URL=http://localhost:3010
#OPENROUTER_APP_NAME=Excel Content Processor


# Optional: point at an OpenAI-compatible gateway or proxy instead.
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Parallel translation batches. Default 4 for Gemini models
# Lower it if you hit rate limits, raise it if your plan allows.
#TRANSLATION_CONCURRENCY=4

# Parallel image classifications for "Images With Text". Default 4, max 16.
#IMAGE_ANALYSIS_CONCURRENCY=4

# Where image verdicts are cached. Defaults to data/image-text-cache.json.
#IMAGE_TEXT_CACHE_PATH=./data/image-text-cache.json

# Parallel is NOT used for image translation - those calls are billed per image.
# Where translated images are cached: one PNG per image plus a small index.
# Defaults to data/translated-images/.
#IMAGE_TRANSLATE_CACHE_DIR=./data/translated-images

# ---------------------------------------------------------------------------
# Models
#
# Every model the app offers is defined here - nothing is hardcoded. Change a
# line, restart, done: no code edit and no rebuild. Ids are OpenRouter ids; the
# part after "|" is just the label shown in the UI.
# ---------------------------------------------------------------------------

# Text translation models offered in the AI Model panel.
#TRANSLATION_MODELS=openai/gpt-4o-mini|GPT-4o Mini,openai/gpt-4o|GPT-4o,google/gemini-2.5-flash|Gemini 2.5 Flash,google/gemini-2.5-pro|Gemini 2.5 Pro,google/gemini-3-flash-preview|Gemini 3 Flash
#TRANSLATION_MODEL_DEFAULT=openai/gpt-4o-mini

# Model that reads the text inside images ("Images With Text").
# Must accept image input. Defaults to the translation default.
#IMAGE_TEXT_MODEL=openai/gpt-4o-mini

# Image-generation models for "Translate Images". Format: id|Label|costPerImage
# The cost is only used for the estimate shown before a run.
#IMAGE_TRANSLATE_MODELS=google/gemini-3-pro-image|Gemini 3 Pro Image|0.139,openai/gpt-5.4-image-2|GPT-5.4 Image 2|0.05,google/gemini-2.5-flash-image|Gemini 2.5 Flash Image|0.039
#IMAGE_TRANSLATE_MODEL_DEFAULT=google/gemini-3-pro-image
